<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelled on thirdparty/SDL/android-project/app/src/main/AndroidManifest.xml,
  trimmed to what an editor rather than a game needs. The activity is SDL's
  own org.libsdl.app.SDLActivity, unmodified: this project supplies no Java
  of its own, only the native libraries (libmain.so, plus libSDL3.so) that its
  default getLibraries() already expects to find.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- The floor the render backends are written to (gl_api.hpp: "every entry
         here exists in both OpenGL 3.3 core and OpenGL ES 3.0"). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Vulkan is a backend this build carries, not one every device needs to
         have: asking for it as required would keep the app off any device
         whose GPU driver never implemented it, which is exactly what
         defaulting to opengles (src/app.cpp, GLEDITOR_DEFAULT_BACKEND) is for. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="false" />

    <!-- A pointer is welcome but a touchscreen is not what this program is
         driven with. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true">

        <activity android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with gleditor" from a file manager or browser. No
                 storage permission accompanies this on purpose: a Uri
                 delivered through an intent-filter match already comes with
                 its own temporary read grant (content:// and file:// alike),
                 which is what src/android_bootstrap.cpp's
                 openDocumentFromIntent() actually reads through. A
                 broad-storage permission would ask for more access than
                 opening a shared or tapped file ever needs, for no benefit. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Share" a file to gleditor from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>
