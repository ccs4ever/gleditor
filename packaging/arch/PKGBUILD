# Maintainer: ccs4ever <ccs4ever@gmail.com>
#
# makepkg sources this rather than executing it, so it has no shebang of its
# own; the variables below are makepkg's PKGBUILD API, read by makepkg itself
# rather than by this file, and pkgdir is one it injects into package().
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=gleditor
pkgver=0.1.0
pkgrel=1
pkgdesc="GPU-rendered document library, a text editor and a xanadoc editor, with OpenGL, OpenGL ES and Vulkan backends"
arch=('x86_64' 'aarch64')
url="https://github.com/ccs4ever/gleditor"
license=('GPL-3.0-or-later')
depends=('freetype2' 'harfbuzz' 'fribidi' 'libunibreak' 'fontconfig' 'sdl3' 'sdl3_image' 'libglvnd'
         'openssl' 'lmdb' 'libtorrent-rasterbar' 'hicolor-icon-theme')
# The Vulkan backend loads a loader at run time; the other two backends work
# without one, so this is optional rather than a hard dependency.
optdepends=('vulkan-icd-loader: Vulkan backend'
            'ttf-dejavu: default font')
# boost rather than boost-libs: libtorrent-rasterbar's own headers pull in
# boost/predef at compile time, and on Arch the headers live in the full
# 'boost' package -- 'boost-libs', which libtorrent-rasterbar depends on,
# ships only the shared objects.
makedepends=('gcc' 'make' 'pkgconf' 'glm' 'glslang' 'vulkan-headers' 'boost')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver" || exit
  # GLEDITOR_VERSION is passed because the tarball carries no git history, and
  # SDL3 is stated rather than probed so the package cannot silently change
  # which SDL it links depending on what happened to be installed.
  make \
    GLEDITOR_SDL=3 \
    GLEDITOR_ENABLE_VULKAN=1 \
    GLEDITOR_VERSION="$pkgver" \
    lib gleditor xudu shaders
}

package() {
  cd "$pkgname-$pkgver" || exit
  make install \
    DESTDIR="$pkgdir" \
    prefix=/usr \
    libdir=/usr/lib \
    includedir=/usr/include \
    GLEDITOR_SDL=3 \
    GLEDITOR_ENABLE_VULKAN=1 \
    GLEDITOR_VERSION="$pkgver"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
