{
  "version": 1,
  "warmups": 1,
  "repetitions": 7,
  "training_weight_policy": "positive integer multiplier of measured repetitions; validation repetitions are explicit and unweighted",
  "input_identity_kind": "CLI corpus files and generated probe scenario parameters are hashed; test-source dependencies are identified separately",
  "corpus_identity_claim": "CLI train and validation inputs are distinct files, and generated probes use distinct seeds; source-only GoogleTest workloads have synthetic or embedded data and make no held-out corpus claim; P3 link cohorts are deterministic topology classes; their distinct seed tags affect checksum labeling only and do not claim randomized graph inputs",
  "environment_policy": "fresh isolated XDG data, config, and cache directories per warmup and measured sample",
  "probe_measurement_policy": "primary timing commands use --measure timing; optional --collect-counters runs separate --measure allocations commands after timing. The counter pass is off by default and is excluded from primary wall-time and peak-RSS samples. P3 link cohort primary timing selects p3_link_traversal_ns and excludes setup/validation/inspection; its paired allocation/count command classifies constructed scenario edges only, not global eligibility",
