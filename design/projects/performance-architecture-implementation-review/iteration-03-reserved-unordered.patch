+#ifndef ZIGZAG_MANIFOLD_LOOKUP_HPP
+#define ZIGZAG_MANIFOLD_LOOKUP_HPP
+
+#include "common/xanadu/zigzag/prepared_u32_unordered_map.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory_resource>
+#include <optional>
+#include <utility>
+
+namespace zigzag::detail {
+
+/// PMR hash-map byRef candidate with the existing optional lookup surface.
+class ManifoldOpIndexMap : public PreparedU32UnorderedMap<std::uint32_t> {
+  using Base = PreparedU32UnorderedMap<std::uint32_t>;
+
+public:
+  using PrepareFailure = LookupPrepareFailure;
+  using PreparedInsert = Base::PreparedInsert;
+
+  explicit ManifoldOpIndexMap(
+      std::pmr::memory_resource *resource = std::pmr::get_default_resource())
+      : Base(resource) {}
+  ManifoldOpIndexMap(const ManifoldOpIndexMap &)                = default;
+  ManifoldOpIndexMap &operator=(const ManifoldOpIndexMap &)     = default;
+  ManifoldOpIndexMap(ManifoldOpIndexMap &&) noexcept            = default;
+  ManifoldOpIndexMap &operator=(ManifoldOpIndexMap &&) noexcept = default;
+
+  [[nodiscard]] std::size_t opCountHint() const noexcept {
+    return opCountHint_;
+  }
+  ManifoldOpIndexMap *setOpCountHint(std::size_t hint) noexcept {
+    opCountHint_ = hint;
+    return this;
+  }
+  [[nodiscard]] std::optional<std::uint32_t>
+  find(const std::uint32_t op) const noexcept {
+    if (op == 0) return std::nullopt;
+    const auto it = Base::find(op);
+    return it == Base::end() ? std::nullopt
+                             : std::optional<std::uint32_t>{it->second};
+  }
+  [[nodiscard]] bool commitInsert(PreparedInsert &&token, std::uint32_t op,
+                                  std::uint32_t value) noexcept {
+    if (token.key != op) return false;
+    return Base::commitInsert(std::move(token), value);
+  }
+  friend bool operator==(const ManifoldOpIndexMap &left,
+                         const ManifoldOpIndexMap &right) {
+    return static_cast<const Base &>(left) == static_cast<const Base &>(right);
+  }
+
+private:
+  std::size_t opCountHint_{0};
+};
+
+} // namespace zigzag::detail
+
+#endif // ZIGZAG_MANIFOLD_LOOKUP_HPP
