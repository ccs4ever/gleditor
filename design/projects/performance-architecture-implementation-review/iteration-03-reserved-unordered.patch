+    resource.allowAllocations();
+    ASSERT_TRUE(manifold.applyStructure(1, node));
+    Manifold expected;
+    ASSERT_TRUE(expected.applyStructure(1, node));
+    EXPECT_TRUE(manifold.equivalentTo(expected));
+    EXPECT_EQ(manifold.foldedThrough(), 1U);
