+bool fillBirthTableToLimit(Store &store, MicroversionId &at,
+                           Manifold &manifold) {
+  while (zigzag::ManifoldTestAccess::birthSize(manifold) <
+         zigzag::ManifoldTestAccess::birthLimit(manifold)) {
+    at = store.makeCell(at, "growth");
+    if (!manifold.advance(store, at) ||
+        zigzag::ManifoldTestAccess::opCountHint(manifold) != store.opCount())
+      return false;
+  }
+  return true;
+}
