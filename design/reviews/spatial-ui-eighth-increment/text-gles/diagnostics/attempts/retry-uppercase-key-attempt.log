  multiline text input "system://layout" [caret 0]
    text run = "Schema and Purpose
"
    text run = "
"
    text run = "Purpose:
"
    text run = "The sovereign Layout system xanadoc defines multi-column page dimensions, notification toast anchors, pouch dock orientation, and optic ribbon rendering flags.
"
    text run = "
"
    text run = "Schema:
"
    text run = "columns: Number of parallel document columns displayed simultaneously. Default is 2.
"
    text run = "pageWidthPx: Logical page rendering width in pixels. Default is 800.
"
    text run = "pageHeightPx: Logical page rendering height in pixels. Default is 1000.
"
    text run = "toastAnchor: Notification anchor position (top-right, top-left, bottom-right, bottom-left, top-center). Default is top-right.
"
    text run = "toastOffsetX: Horizontal offset in pixels for toast notification window. Default is 24.
"
    text run = "toastOffsetY: Vertical offset in pixels for toast notification window. Default is 48.
"
    text run = "pouchDock: Edge alignment for span drop pouches (left or right). Default is right.
"
    text run = "documentSpacingX: Horizontal gap between parallel document columns in pixels. Default is 70.
"
    text run = "readableTextPx: On-screen height, in screen pixels, of a line of document text at the default zoom and wherever the camera frames a passage for reading, including bringing a linked document "
    text run = "alongside; the overview panel shows the whole scene instead. Zero frames whole pages. Default is 16.
"
    text run = "transclusionPrisms: Enable Identity Gold volumetric prisms for transcluded spans. Default is true.
"
    text run = "transclusionLoom: Bundle adjacent rank transclusions into continuous golden looms. Default is true.
"
    text run = "xanalinkRibbons: Enable cyan and magenta 3D optical link ribbons. Default is true.
"
    text run = "physics:
"
    text run = "  kRepel: Soft-body Coulomb repulsion constant between documents. Default is 4500.0.
"
    text run = "  kPlane: Spring constant pulling active documents to Z = 0 reading plane. Default is 14.0.
"
    text run = "  kAlign: Collinear link alignment spring constant. Default is 28.0.
"
    text run = "  kTier: Depth holding spring constant for background corpora. Default is 12.0.
"
    text run = "  kDamping: Linear velocity damping coefficient. Default is 7.5.
"
    text run = "  backgroundDepthZ: Resting background depth coordinate. Default is -40.0.
"
    text run = "  defaultGap: Minimum comfortable horizontal reading gap. Default is 8.0.
"
    text run = "  maxForce: Maximum instantaneous physical force magnitude. Default is 10000.0.
"
    text run = "  maxVelocity: Maximum linear velocity magnitude for physical stability. Default is 1000.0.
"
    text run = "  timeStep: Default simulation time step in seconds. Default is 0.016.
"
    text run = "beams:
"
    text run = "  bandStrandLimit: Maximum number of ribbon strands per link band. Default is 7.
"
    text run = "  bandStrandPitch: Spacing between strands in beam widths. Default is 2.2.
"
    text run = "  bandFillAlpha: Alpha multiplier for inner band fill strands. Default is 0.85.
"
    text run = "  stubWidthOfBeam: Width multiplier for margin anchor spine relative to beam width. Default is 1.35.
"
    text run = "  stubMinOfLine: Shortest margin anchor bracket as fraction of line height. Default is 0.9.
"
    text run = "  marginKerf: Gap between margin anchors sharing a lane. Default is 0.04.
"
    text run = "  bypassDepthPerDoc: Z offset per document passed when routing behind. Default is -20.0.
"
    text run = "  bypassDepthLimit: Deepest Z offset for bypass routing. Default is -120.0.
"
    text run = "  curveSegments: Curve subdivision segment count for NURBS routing. Default is 32, bounded 8 to 256.
"
    text run = "  curveHandleShare: Endpoint tangent reach as a share of the gap. Default 0.3.
"
    text run = "  inactiveLinkAlpha: Other links recede while one is selected. Default 0.35.
"
    text run = "  curveWeight: Rational weight of the inner controls. Default 1.0.
"
    text run = "  gatheringShare: Endset hubs gather at this fraction of the gap. Default 0.32.
"
    text run = "  loomBundlingEnabled: Group contiguous rank transclusion strands into unified laminar looms. Default is true.
"
    text run = "  loomAlpha: Semi-transparent resting alpha for golden transclusion looms. Default is 0.35.
"
    text run = "  loomHoverAlpha: Active or hovered alpha for brightened transclusion strands. Default is 1.0.
"
    text run = "  zFightJitterAmplitude: Deterministic small Z nudge (+/-), derived from each beam's own link or tag id, so beams that cross in screen space rarely land at exactly the same depth. Default is 0.6.
"
    text run = "  activeZBoost: Z boost added to the active or selected link's beam, kept well clear of zFightJitterAmplitude so the selected beam always renders in front of a crossing one. Default is 4.0.
"
    text run = "zigzag: System-slice presentation policy for cell card padding, content width limits, rank clearance, HUD spacing, and connection beam width. All lengths are logical pixels.
"
    text run = "zigzag.minReadableTextPx: Smallest on-screen height, in screen pixels, of a line of card text when the presentation sits beside a page; below it the presentation is scaled up, never down. Zero keeps "
    text run = "the page's own scale. Default is 14.
"
    text run = "Notes
"
    text run = "
"
    text run = "User Annotations and Customization Record:
"
    text run = "This page is reserved for author notes, screen dimension notes, and optical rendering customizations.
"
    text run
