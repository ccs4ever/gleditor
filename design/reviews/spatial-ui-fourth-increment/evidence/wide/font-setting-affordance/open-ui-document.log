  multiline text input "system://ui" [caret 0]
    text run = "Schema and Purpose
"
    text run = "
"
    text run = "Purpose:
"
    text run = "The sovereign UI system xanadoc configures visibility of chrome bars, status indicators, hypertime navigation overlays, and interactive radial action wheels.
"
    text run = "
"
    text run = "Schema:
"
    text run = "notificationPosition: Screen location for system notifications. Default is top-right.
"
    text run = "notificationDurationMs: Duration in milliseconds before notifications dismiss. Default is 3000.
"
    text run = "tabBarVisible: Flag indicating whether top document tab bar is visible. Default is true.
"
    text run = "statusBarVisible: Flag indicating whether bottom status bar is visible. Default is true.
"
    text run = "hypertimeMapVisible: Flag indicating whether hypertime graph overlay is open. Default is false.
"
    text run = "ui.scale and ui.fontScale: Positive finite geometry and typography multipliers; both default to 1. ui.safeMarginShare: Safe-area margin fraction, 0 to 0.5, default 0.05. ui.minFontPx and "
    text run = "ui.minTouchPx: Positive finite minimum font and touch sizes in pixels, defaults 9 and 44.
"
    text run = "ui.font.caption, ui.font.label, ui.font.body, ui.font.title and ui.font.mono: Each role has family and points settings. Defaults are Sans 10, Sans 12, Sans 12, Sans Bold 18 and Monospace 12. Family "
    text run = "must be nonempty; point size must be positive and finite. Document fonts remain in system://settings.
"
    text run = "Input and text presentation: FocusManager owns scope registration, activation order and modal isolation. Each modal blocks background input and permits only configured global commands. Labels use "
    text run = "typed typography roles and TextFit boxes; full accessible names remain available when visual labels are ellipsized or hidden.
"
    text run = "radialMenu: Nested configuration dictionary defining action items, icons, and radial radius.
"
    text run = "overview.visible, overview.widthPx, overview.heightPx, overview.leftPx, overview.bottomPx: Whether the overview panel is shown -- every open page condensed into the lower left, with the camera's view "
    text run = "outlined -- its size, and its distance from the window's left and bottom edges, in logical pixels. Defaults are true, 220, 160, 16 and 56.
"
    text run = "overview.backgroundColour, overview.pageColour, overview.viewportColour, overview.markColour: Its colours as RGBA integers; marks show the selected link's chosen places and the focused ZigZag card.
"
    text run = "tether: A temporary quotation tendril. rootWidthPx and tipWidthPx default to 4.5 and 1 logical pixels. sagPx and sagShare bound the curve (40 and 0.18). pointerRadiusPx and pointerGapPx keep the "
    text run = "target clear (6 and 2). texturePeriodPx and textureStrength control stationary fibres (24 and 0.25). colour is packed RGBA (0xDDB441DC). reducedMotion follows input directly and cancels without a "
    text run = "spring transition (false).
"
    text run = "satelloidCard, tetherCard and hullCard: Preferred widthPx and heightPx in logical pixels, defaults 200 by 180, 190 by 88 and 260 by 46. Positive finite lengths grow for typography within "
    text run = "maxWidthShare and maxHeightShare (0.1 to 1, default 0.9). maxLines bounds preview lines (1 to 10, default 3). World labels hide below the typography minimum projected font size; full names and card "
    text run = "selection remain available.
"
    text run = "quotationModal, telescopeModal and hypertimeModal: Preferred widthPx and heightPx in logical pixels, defaults 840 by 560, 860 by 560 and 640 by 460. Positive finite values are required. Their "
    text run = "maxWidthShare and maxHeightShare bound the modal to safe-area shares, range 0.1 to 1, default 0.95.
"
    text run = "pouchPanel.widthPx and storePanel.widthPx: Preferred panel widths in logical pixels, defaults 320 and 340. Positive finite values are required. The panels grow for readable controls within their "
    text run = "safe-area limits.
"
    text run = "pouchPanel.maxWidthShare, pouchPanel.maxHeightShare, storePanel.maxWidthShare and storePanel.maxHeightShare: Maximum shares of safe width and height, range 0.1 to 1. Width defaults are 0.9 and height "
    text run = "defaults are 1.
"
    text run = "linkPanel.font: Caption, label, body, title or mono role name (lowercase); default is label. Empty also follows label. Legacy explicit font descriptions remain accepted and follow display and font "
    text run = "scales.
"
    text run = "linkPanel.maxLines: Maximum wrapped description lines; default 3, range 1 to 20. linkPanel.maxWidthShare and linkPanel.maxHeightShare: Maximum shares of the safe area; width default 0.9, height "
    text run = "default 1, range 0.1 to 1.
"
    text run = "linkPanel.marginPx, linkPanel.topPx, linkPanel.paddingPx, linkPanel.lineGapPx: The panel's distance from the window's right and top edges, its inner space and its line spacing, in logical pixels. "
    text run = "Defaults are 16, 44, 10 and 4.
"
    text run = "linkPanel.backgroundColour, linkPanel.textColour, linkPanel.mutedColour, linkPanel.buttonColour: Panel colours as RGBA integers, the muted one for unset choices, members not in view and buttons that "
    text run = "would be refused.
"
    text run = "linkPanel.chosenEdgeWidthPx, linkPanel.memberEdgeWidthPx: Same-hue edge widths for the active chosen occurrence and secondary occurrences, in device pixels. Defaults are 2.5 and 1.
"
    text run = "Notes
"
    text run = "
"
    text run = "User Annotations and Customization Record:
"
    text run = "Edit ui.scale or ui.fontScale to resize chrome independently of documents. Set ui.font.<role>.family and ui.font.<role>.points to customize caption, label, body, title or mono. Each setting's native "
    text run = "d.schemas and d.notes ranks describe its value and defaults. Choose a role in linkPanel.font to keep that panel following live typography; existing explicit font descriptions still work.
"
    text run = "
"
    text run = "Labels grow with UI and font scales. Increase pouchPanel.widthPx or drag the pouch drawer edge to give labels more room. World cards retain full accessible names when their projected labels hide. Tab "
    text run = "follows layout order inside the active scope; Escape closes it. Modal global commands remain subject to the keymap allow list.
"
    text run = "
"
    text run = "This page is reserved for author notes, workflow preferences, and custom radial action mappings.
